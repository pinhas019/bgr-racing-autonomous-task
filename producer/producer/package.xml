<?xml version="1.0"?>
<package format="3">
  <name>producer</name>
  <version>0.1.0</version>
  <description>Publishes the datasets: track boundaries (nav_msgs/Path) and a LiDAR frame (sensor_msgs/PointCloud2).</description>
  <maintainer email="noreply@example.com">BGR candidate</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
